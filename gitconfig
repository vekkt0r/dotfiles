[user]
	name = Adam Engstrom
	email = adaengst@gmail.com
[alias]
   out = log @{u}..
[push]
	default = simple
[pager]
	branch = false
[merge]
	tool = vimdiff
[mergetool "vimdiff"]
	path = nvim
[color]
	ui = auto
[init]
	defaultBranch = master
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
